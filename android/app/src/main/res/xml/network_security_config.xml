<?xml version="1.0" encoding="utf-8"?>
<!--
  Release / main cleartext policy (strict):
  - base-config cleartextTrafficPermitted=false (default deny)
  - cleartext only for localhost / emulator host loopback
  Debug builds replace this file via src/debug/res/xml/network_security_config.xml
  (base-config cleartextTrafficPermitted=true) because on API 24+ the network
  security config overrides android:usesCleartextTraffic for cleartext decisions.
  Android domain-config does not support CIDR ranges; name exact hosts as needed.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Android emulator alias for host machine loopback -->
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>

